# Copy to .env (git-ignored).
# SEC EDGAR requires a name and contact email on every request (Company Research page)
SEC_USER_AGENT=Portfolio Risk Lab your.email@example.com
# Claude writes the portfolio assistant's chat replies (console.anthropic.com > API Keys). Optional: without it the
# assistant uses its built-in template answers. Never commit the real key.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Team passcode for saving portfolio changes on the site (Portfolio > Edit portfolio). Without it, saving is off.
PORTFOLIO_EDIT_PASSCODE=choose-a-team-passcode
